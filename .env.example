# BM25 index directory; relative paths are resolved against the repo root
BM25_DIR=data/processed/bm25_index
# Raw legal documents (MCP get_article reads full text from here); relative to the repo root
RAW_DATA_PATH=data/raw/van-ban-phap-luat.json
